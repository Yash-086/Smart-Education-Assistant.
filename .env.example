# Local Ollama provider (backend only; no API key required)
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2
LLM_TIMEOUT_SECONDS=60

# Optional alternative provider: set LLM_PROVIDER=huggingface and provide a token.
# HF_TOKEN=
# HF_MODEL=openai/gpt-oss-120b

# Optional current web research through Tavily. Ordinary questions do not need this key.
TAVILY_API_KEY=
SEARCH_TIMEOUT_SECONDS=12

# Local SQLite database (kept outside version control)
DATABASE_URL=sqlite:///./data/smart_education_assistant.db
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_BYTES=20971520
